<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 300" role="img" aria-labelledby="title desc">
<title id="title">Macantsaoir Capital Partners Logo</title>
<desc id="desc">Gold classical pillar mark above Macantsaoir Capital Partners wordmark.</desc>
<defs>
  <linearGradient id="gold" x1="0" x2="1" y1="0" y2="1">
    <stop offset="0%" stop-color="#F1D38A"/>
    <stop offset="45%" stop-color="#C9A050"/>
    <stop offset="100%" stop-color="#8C6928"/>
  </linearGradient>
</defs>
<rect width="720" height="300" fill="none"/>
<g fill="url(#gold)" transform="translate(310 24)">
  <path d="M50 0 L105 42 H78 L50 20 L22 42 H-5 Z"/>
  <rect x="5" y="56" width="90" height="13" rx="2"/>
  <rect x="16" y="79" width="12" height="74"/>
  <rect x="44" y="79" width="12" height="74"/>
  <rect x="72" y="79" width="12" height="74"/>
  <path d="M8 166 H92 L76 183 H24 Z"/>
</g>
<text x="360" y="225" text-anchor="middle" font-family="Georgia, 'Times New Roman', serif" font-size="55" letter-spacing="7" fill="url(#gold)">MACANTSAOIR</text>
<line x1="140" y1="247" x2="270" y2="247" stroke="#C9A050" stroke-width="2"/>
<line x1="450" y1="247" x2="580" y2="247" stroke="#C9A050" stroke-width="2"/>
<text x="360" y="260" text-anchor="middle" font-family="Georgia, 'Times New Roman', serif" font-size="24" letter-spacing="11" fill="url(#gold)">CAPITAL PARTNERS</text>
</svg>